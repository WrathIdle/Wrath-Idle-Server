<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <BuildInParallel>false</BuildInParallel>
    <UseMultiToolTask>true</UseMultiToolTask>
    <EnforceProcessCountAcrossBuilds>true</EnforceProcessCountAcrossBuilds>
    <MultiProcMaxCount Condition="'$(MultiProcMaxCount)' == ''">1</MultiProcMaxCount>
    <CL_MPCount Condition="'$(CL_MPCount)' == ''">1</CL_MPCount>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WrathIdleStagedExecutable)' != '' and '$(TargetName)' == 'worldserver'">
    <OutDir>$([System.IO.Path]::GetDirectoryName('$(WrathIdleStagedExecutable)'))\</OutDir>
    <TargetPath>$(WrathIdleStagedExecutable)</TargetPath>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(WrathIdleStagedExecutable)' != '' and '$(TargetName)' == 'worldserver'">
    <Link>
      <OutputFile>$(WrathIdleStagedExecutable)</OutputFile>
      <GenerateMapFile>true</GenerateMapFile>
      <MapFileName>$(WrathIdleStagedExecutable).map</MapFileName>
    </Link>
  </ItemDefinitionGroup>
  <PropertyGroup Condition="'$(WrathIdleStagedClient)' != '' and '$(TargetName)' == 'WowClient64'">
    <OutDir>$([System.IO.Path]::GetDirectoryName('$(WrathIdleStagedClient)'))\</OutDir>
    <TargetPath>$(WrathIdleStagedClient)</TargetPath>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(WrathIdleStagedClient)' != '' and '$(TargetName)' == 'WowClient64'">
    <Link>
      <OutputFile>$(WrathIdleStagedClient)</OutputFile>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="WrathIdleArchive" DependsOnTargets="PrepareForBuild;ResolveReferences;_Lib" />
  <Target Name="WrathIdleLink" DependsOnTargets="_BuildLinkAction" />
  <Target Name="WrathIdleLimitCompilerWorkers" BeforeTargets="SelectClCompile;ClCompile">
    <ItemGroup>
      <ClCompile>
        <MultiProcessorCompilation>false</MultiProcessorCompilation>
        <ProcessorNumber>1</ProcessorNumber>
      </ClCompile>
    </ItemGroup>
  </Target>
</Project>
